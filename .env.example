# ===== Rumbo — configuración local =====
NODE_ENV=development
LOG_LEVEL=info

# --- Infraestructura ---
DATABASE_HOST_URL=postgresql://rumbo:rumbo_local_2026@localhost:5440
AUTH_DATABASE_URL=postgresql://rumbo:rumbo_local_2026@localhost:5440/rumbo_auth
ORDERS_DATABASE_URL=postgresql://rumbo:rumbo_local_2026@localhost:5440/rumbo_orders
PAYMENTS_DATABASE_URL=postgresql://rumbo:rumbo_local_2026@localhost:5440/rumbo_payments
DISPATCH_DATABASE_URL=postgresql://rumbo:rumbo_local_2026@localhost:5440/rumbo_dispatch
MAPS_DATABASE_URL=postgresql://rumbo:rumbo_local_2026@localhost:5440/rumbo_maps
NOTIFICATIONS_DATABASE_URL=postgresql://rumbo:rumbo_local_2026@localhost:5440/rumbo_notifications
ANALYTICS_DATABASE_URL=postgresql://rumbo:rumbo_local_2026@localhost:5440/rumbo_analytics
REDIS_URL=redis://localhost:6390

# --- Puertos / URLs internas ---
GATEWAY_PORT=4000
AUTH_SERVICE_URL=http://localhost:4101
ORDERS_SERVICE_URL=http://localhost:4102
PAYMENTS_SERVICE_URL=http://localhost:4103
DISPATCH_SERVICE_URL=http://localhost:4104
MAPS_SERVICE_URL=http://localhost:4105
AI_SERVICE_URL=http://localhost:4106
NOTIFICATIONS_SERVICE_URL=http://localhost:4107
ANALYTICS_SERVICE_URL=http://localhost:4108
TRACKING_SERVICE_URL=http://localhost:4109
WEB_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Seguridad ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
INTERNAL_SERVICE_SECRET=
# La caducidad del token vive SOLO aquí (antes: cuarenta archivos).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- Correo (appprueba695@gmail.com) ---
# MAIL_DRIVER: smtp | relay | console
MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=appprueba695@gmail.com
SMTP_PASSWORD=
MAIL_FROM_NAME=Rumbo Entregas
MAIL_FROM_ADDRESS=appprueba695@gmail.com
# Relay HTTPS (Apps Script) para hosts que bloquean SMTP (Railway)
EMAIL_RELAY_URL=
EMAIL_RELAY_SECRET=

# --- Simulación ---
TRACKING_SIM_SECONDS=90
