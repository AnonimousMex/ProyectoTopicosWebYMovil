// Servicio de pagos: cobros con idempotencia y pasarela simulada.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("PAYMENTS_DATABASE_URL")
}

enum PaymentStatus {
  ACREDITADO
  RECHAZADO
  REEMBOLSADO
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  folio             String
  clienteId         String
  monto             Float
  moneda            String        @default("MXN")
  status            PaymentStatus
  marca             String
  ultimos4          String
  titular           String
  referencia        String?
  motivoRechazo     String?
  /// Sólo se llena cuando el cobro se acredita: UNIQUE garantiza un solo cargo por pedido.
  acreditadoOrderId String?       @unique
  idempotencyKey    String?
  createdAt         DateTime      @default(now())
  refundedAt        DateTime?

  @@index([orderId])
  @@index([clienteId, createdAt])
}

/// Registro de llaves de idempotencia: el mismo clic repetido devuelve la misma respuesta.
model IdempotencyKey {
  key            String   @id
  requestHash    String
  estado         String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model OutboxEvent {
  id            String    @id @default(uuid())
  type          String
  payload       Json
  correlationId String?
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?

  @@index([publishedAt, createdAt])
}

model ProcessedEvent {
  eventId     String
  consumer    String
  processedAt DateTime @default(now())

  @@id([eventId, consumer])
}
